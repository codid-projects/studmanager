# Copy to .env next to docker-compose.yml on the VPS (in Portainer: paste into
# the stack's "Environment variables" section instead).

# --- image tag to run ---
# "latest", or a specific $(Build.BuildId) from the pipeline to roll back.
IMAGE_TAG=latest

# --- what is NOT here ---
# NEXT_PUBLIC_STUDMANAGER_API_URL / _API_MODE are intentionally absent.
# Next inlines them at build time into both the client and server bundles,
# so they only take effect via the pipeline's `apiUrl` / `apiMode` variables.
# Setting them here would do nothing.

# Copy to .env next to docker-compose.yml on the VPS (in Portainer: paste into
# the stack's "Environment variables" section instead).

# --- backend API (runtime — no rebuild needed) ---
# Resolved into the bundles by docker-entrypoint.sh on container start.
# Applies on redeploy/recreate, not on a bare `docker restart`.
# Must start with http:// or https:// or the container refuses to start.
STUDMANAGER_API_URL=https://studmanagerapi-dev.studmarket.net

# --- image tag to run ---
# "latest", or a specific $(Build.BuildId) from the pipeline to roll back.
IMAGE_TAG=latest

# --- Nginx Proxy Manager network to join ---
# docker inspect <npm-container> -f '{{json .NetworkSettings.Networks}}'
NPM_NETWORK=npm_default

# --- what is NOT here ---
# NEXT_PUBLIC_STUDMANAGER_API_MODE is build-time only (pipeline variable
# `apiMode`) and must stay `direct`: `server` mode needs app/api routes that
# do not all exist yet.
